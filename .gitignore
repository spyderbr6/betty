# amplify
.amplify
amplify_outputs*
# ...but the placeholder config the e2e suite falls back to is safe to commit:
# it holds no credentials and points at a user pool that does not exist.
!amplify_outputs.example.json
amplifyconfiguration*

# Expo native build folders (regenerated by expo prebuild)
# Allow configuration files but ignore build artifacts
android/app/build/
android/build/
android/.gradle/
android/app/src/main/assets/
android/app/src/main/res/drawable-*/
android/app/src/main/res/raw/
ios/

# Temporary files
nul
VAPID_KEYS.md

# Playwright e2e
test-results/
playwright-report/
blob-report/
.playwright/

# Firebase service account keys (FCM V1 push credentials).
# These are PRIVATE — upload to EAS with `eas credentials`, never commit.
# google-services.json is deliberately NOT ignored: it holds public
# identifiers only, and EAS needs it in the repo because android/ is
# committed (EAS does not prebuild, so the file must already be there).
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
sidebet-*-*.json
