# Configuration reference for SideBet.
#
# Values reach the app through THREE different mechanisms. Putting a value in
# the wrong one either does nothing or leaks it, so the split matters.
# Copy the first section into a local .env (gitignored); the rest are not .env.


# ---------------------------------------------------------------------------
# 1. CLIENT — read from .env by react-native-dotenv, INLINED INTO THE BUNDLE
# ---------------------------------------------------------------------------
# Extractable from any published build. Nothing secret belongs here.

# Public by design; ships in every Stripe mobile app. Use pk_test_ locally.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Used by src/utils/github.ts for in-app feedback issues. This ships inside the
# APK — scope it to issues on this repo only and treat it as public. Blank
# disables the feature (falls back to 'demo_mode').
GITHUB_TOKEN=


# ---------------------------------------------------------------------------
# 2. BACKEND SECRETS — NOT .env. Set via the CLI, stored in AWS SSM.
# ---------------------------------------------------------------------------
# Referenced as secret('NAME') in amplify/functions/*/resource.ts. The value is
# stored as an SSM reference resolved at runtime, so it never lands in your
# repo, your synth output, or the CloudFormation template.
#
#   npx ampx sandbox secret set STRIPE_SECRET_KEY
#   npx ampx sandbox secret set STRIPE_WEBHOOK_SECRET
#   npx ampx sandbox secret set STRIPE_PRO_PRICE_ID
#
# Sandbox secrets are isolated per developer and do NOT inherit from the
# branch. Production/branch equivalents are managed in the Amplify Console
# under App settings -> Secrets.
#
#   STRIPE_SECRET_KEY      (stripe-manage, stripe-payment-intent, stripe-webhook)
#   STRIPE_WEBHOOK_SECRET  (stripe-webhook)
#   STRIPE_PRO_PRICE_ID    (stripe-manage)


# ---------------------------------------------------------------------------
# 3. BACKEND BUILD-TIME — real shell environment, read during `ampx sandbox`
# ---------------------------------------------------------------------------
# amplify/functions/*/resource.ts reads these with process.env AT SYNTH TIME.
# A .env file does NOT feed these; export them in your shell (or set them in
# the Amplify Console for branch builds).
#
# CAUTION: whatever these resolve to is baked into the generated CloudFormation
# template and the Lambda's plaintext env config. Fine for identifiers and
# URLs; NOT safe for real secrets — those belong in section 2.
#
#   AMPLIFY_DATA_GRAPHQL_ENDPOINT   supplied by Amplify; do not set by hand
#   EXPO_ACCESS_TOKEN               Expo push sending; blank works for basic sends
#   WEB_PUSH_EMAIL                  defaults to mailto:admin@sidebet.app
#   WEB_PUSH_PUBLIC_KEY             VAPID public key; has a default, safe to expose
#   VAPID_PRIVATE_KEY               see warning below
#   STRIPE_PORTAL_RETURN_URL        defaults to sidebet://account
#
# VAPID_PRIVATE_KEY is a private key currently wired through process.env, which
# means setting it writes it into the CloudFormation template in plaintext. It
# should be migrated to secret() like the Stripe keys before web push is used
# in production.
